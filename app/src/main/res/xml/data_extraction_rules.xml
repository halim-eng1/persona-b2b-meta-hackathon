<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude hardware Keystore encrypted credentials to avoid AEADBadTagException on restore -->
        <exclude domain="sharedpref" path="persona_secure_credentials.xml" />
        <exclude domain="database" path="persona_database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="persona_secure_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
